{
  "name": "cirno-webui",
  "private": true,
  "version": "0.2.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gallery": "vite --open /gallery.html",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:browser": "tsc -p tsconfig.browser.json && playwright test",
    "lint": "eslint --config eslint.config.js src channels browser --max-warnings 0"
  },
